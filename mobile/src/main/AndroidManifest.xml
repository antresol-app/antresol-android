<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- «Sign in a TV»: reads the TV's QR code on the device (asked only on that screen). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Phones and tablets without a camera can still type the TV's code. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <!-- The CAMERA permission otherwise implies a required rear camera. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- The players lock to landscape (sensorLandscape), which Play reads as a required landscape screen and
         which would hide the app from portrait-only devices. Every phone can show landscape; nothing else needs it. -->
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false" />

    <!-- usesCleartextTraffic: home servers are usually plain http on the LAN. -->
    <application
        android:name=".AntresolMobileApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Antresol"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Landscape video; handles its own rotation and picture-in-picture resizes. -->
        <activity
            android:name=".player.VideoPlayerActivity"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Antresol" />

        <!-- A trailer, landscape: the app's own player or the embedded one; no picture-in-picture. -->
        <activity
            android:name=".player.TrailerPlayerActivity"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Antresol" />

        <!-- A live channel: portrait with the programme and the channels under the picture, landscape full screen; picture-in-picture on leaving. -->
        <activity
            android:name=".player.LivePlayerActivity"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Antresol" />

        <!-- Music and audiobooks in the background, with the system media notification. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
